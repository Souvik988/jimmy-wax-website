# Public API origin (https required in production). Everything else is optional.
VITE_API_ORIGIN=https://api.example.com
# Optional separate media/CDN origin (media is only ever loaded from the API origin or this one)
VITE_MEDIA_ORIGIN=
# Build-time only (sitemap/robots): the public https origin of this storefront
SITE_ORIGIN=https://www.example.com
# Used by the dev/preview servers to allow framing of ?jw_preview pages by the dashboard
DASHBOARD_PUBLIC_ORIGIN=http://localhost:3200
