{
  "name": "jimmy-wax-storefront",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/preflight.mjs && tsc -b && vite build",
    "postbuild": "node scripts/postbuild.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "contract:check": "node scripts/contract-check.mjs",
    "preflight": "node scripts/preflight.mjs",
    "verify": "npm run contract:check && npm run test:preflight && npm test && npm run build:preview",
    "build:preview": "tsc -b && vite build",
    "postbuild:preview": "node scripts/postbuild.mjs",
    "test:preflight": "node --test scripts/preflight.test.mjs"
  },
  "dependencies": {
    "lenis": "^1.3.26",
    "motion": "^13.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "vitest": "5.0.5",
    "vite": "8.3.5",
    "typescript": "7.0.2",
    "@vitejs/plugin-react": "6.1.2"
  },
  "overrides": {
    "source-map-js": "^1.2.2"
  },
  "engines": {
    "node": ">=22"
  }
}
